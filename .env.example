# Neon Postgres connection string (https://neon.tech - free tier is plenty)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Model provider -------------------------------------------------------
# Bench runs on either provider. Set the key for the one you want; if only one
# key is present it is used automatically, and BENCH_PROVIDER overrides.
#
# BENCH_PROVIDER="anthropic"   # anthropic | moonshot

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# Kimi K3 (https://platform.kimi.ai) - requires a minimum $1 top-up
# MOONSHOT_API_KEY="sk-..."

# Model override. Defaults: claude-opus-5 / kimi-k3
# BENCH_MODEL=""

# Reasoning effort. Claude: low|medium|high|xhigh|max. Kimi: low|high|max
# (medium and xhigh collapse to the nearest value Kimi accepts).
# BENCH_EFFORT="high"
